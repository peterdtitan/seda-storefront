{
  "name": "seda-storefront",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "sanity:deploy": "sanity deploy",
    "seed": "sanity exec scripts/seed.ts --with-user-token",
    "db:migrate": "node scripts/migrate.mjs",
    "db:status": "node scripts/migrate.mjs --status",
    "admin:invite": "node scripts/admin-invite.mjs",
    "env:push": "bash scripts/vercel-env.sh"
  },
  "dependencies": {
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.15.0",
    "next": "16.3.5",
    "next-auth": "5.0.0-beta.32",
    "next-sanity": "^13.3.4",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.28.1",
    "sanity": "^6.15.0",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "typescript": "^5",
    "vercel": "^59.23.2"
  },
  "packageManager": "pnpm@12.5.1",
  "description": "\u0218\u00e8d\u00e1 storefront \u2014 contemporary Adire, Lagos.",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10"
  }
}
