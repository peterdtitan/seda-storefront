# Never commit .env.local.

# Sanity — from https://www.sanity.io/manage (Project settings)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

NEXT_PUBLIC_SANITY_API_VERSION=2026-09-22

SANITY_API_READ_TOKEN=

DATABASE_URL=

NEXT_PUBLIC_SITE_URL=

PAYSTACK_SECRET_KEY=

# Editor permissions. Only used to take sold units out of stock after a payment.
SANITY_API_WRITE_TOKEN=

# Auth.js — admin sign-in. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Resend — magic links now, customer emails from step 6.
# EMAIL_FROM must be on a domain verified in the Resend dashboard.
RESEND_API_KEY=
EMAIL_FROM=
