# Șèdá storefront — copy to .env.local and fill in.
# Never commit .env.local.

# Sanity — from https://www.sanity.io/manage (Project settings)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API version the client pins to (YYYY-MM-DD). Bump deliberately.
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-22

# Viewer/read token for draft previews and server-side fetches.
# Create under Project settings → API → Tokens with "Viewer" permissions.
SANITY_API_READ_TOKEN=

# Analytics. Postgres (Supabase gives you this under Project settings -> Database).
# Unset is safe: events are dropped and the dashboards read empty, nothing breaks.
# Apply db/migrations/*.sql before the first event lands.
DATABASE_URL=

# Canonical origin, used for metadataBase, canonical links, Open Graph and the
# sitemap. Set this ONLY on production. Leave it unset everywhere else so previews
# fall back to their own VERCEL_URL and serve a robots.txt that disallows crawling —
# set to the live domain, a preview would advertise production URLs and compete with
# it for the same queries.
NEXT_PUBLIC_SITE_URL=

# Paystack. Test keys are sk_test_*/pk_test_*, live keys sk_live_*/pk_live_*.
# The secret key signs webhooks as well as authorising API calls, so it is the only
# one the server needs. Unset is safe: checkout tells the shopper card payment is not
# switched on and points them at the studio instead of failing silently.
# Webhook URL to register in the Paystack dashboard: <origin>/api/paystack/webhook
PAYSTACK_SECRET_KEY=
